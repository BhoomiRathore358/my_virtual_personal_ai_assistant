10. Main server\par
server.js\par
\par
import express from "express";\par
import cors from "cors";\par
import dotenv from "dotenv";\par
\par
import connectDB from "./config/db.js";\par
\par
dotenv.config();\par
\par
const app = express();\par
\par
app.use(cors());\par
app.use(express.json());\par
\par
connectDB();\par
\par
app.get("/", (req, res) => \{\par
  res.json(\{\par
    message: "AI Assistant API running"\par
  \});\par
\});\par
\par
const PORT = process.env.PORT || 5000;\par
\par
app.listen(PORT, () => \{\par
  console.log(`Server running on port $\{PORT\}`);\par
\});\par
