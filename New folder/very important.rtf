4. MongoDB connection\par
server/config/db.js\par
\par
import mongoose from "mongoose";\par
\par
const connectDB = async () => \{\par
  try \{\par
    await mongoose.connect(process.env.MONGO_URI);\par
\par
    console.log("MongoDB Connected");\par
  \} catch (error) \{\par
    console.error("MongoDB connection failed:", error.message);\par
    process.exit(1);\par
  \}\par
\};\par
\par
export default connectDB;\par
